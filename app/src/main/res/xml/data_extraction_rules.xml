<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Cloud backup is disabled app-wide (allowBackup=false); user content is restored from
         Firebase cloud sync. Keep sensitive local prefs out of device-to-device transfer too. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="UserPrefs.xml" />
        <exclude domain="sharedpref" path="AI_Settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="UserPrefs.xml" />
        <exclude domain="sharedpref" path="AI_Settings.xml" />
    </device-transfer>
</data-extraction-rules>