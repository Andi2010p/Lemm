<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- Header Section (Input Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/primary_light"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/surface_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Problem Input"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark" />

                <ImageButton
                    android:id="@+id/btnStopAI"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_delete"
                    android:visibility="gone"
                    app:tint="@color/error_red" />

                <ImageButton
                    android:id="@+id/btnResizeText"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_zoom"
                    app:tint="@color/secondary" />

                <ImageButton
                    android:id="@+id/btnToggleInput"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inputExpandableArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tlDescription"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Problem description"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="1"
                        android:maxLines="2"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tlExtraCommands"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="AI instructions (Optional)"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExtraCommands"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="1"
                        android:maxLines="1"
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnSolveProblem"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="Analyze &amp; Visualize"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Vision Bar (Shown when viewing history) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/visionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvVisionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Saved Solution"
                android:textColor="@color/primary_dark"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnEnterEditMode"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                app:icon="@android:drawable/ic_menu_edit"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Canvas Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/canvasCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/resultSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintVertical_weight="0.7">

        <FrameLayout
            android:id="@+id/canvasContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF">

            <com.example.lemm.GeometryCanvas
                android:id="@+id/geometryCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

            <com.example.lemm.GeometryCanvas3D
                android:id="@+id/geometryCanvas3D"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Zoom Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/floating_controls_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_zoom_out_custom"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvZoomPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="100%"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_zoom"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- Rotation Controls (3D ONLY) -->
            <LinearLayout
                android:id="@+id/rotationControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/floating_controls_bg"
                android:orientation="vertical"
                android:padding="2dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnRotXMinus" android:layout_width="36dp" android:layout_height="36dp" android:text="-X" android:padding="0dp" android:textSize="10sp" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                    <Button android:id="@+id/btnRotXPlus" android:layout_width="36dp" android:layout_height="36dp" android:text="+X" android:padding="0dp" android:textSize="10sp" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnRotYMinus" android:layout_width="36dp" android:layout_height="36dp" android:text="-Y" android:padding="0dp" android:textSize="10sp" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                    <Button android:id="@+id/btnRotYPlus" android:layout_width="36dp" android:layout_height="36dp" android:text="+Y" android:padding="0dp" android:textSize="10sp" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnRotZMinus" android:layout_width="36dp" android:layout_height="36dp" android:text="-Z" android:padding="0dp" android:textSize="10sp" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                    <Button android:id="@+id/btnRotZPlus" android:layout_width="36dp" android:layout_height="36dp" android:text="+Z" android:padding="0dp" android:textSize="10sp" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                </LinearLayout>

            </LinearLayout>

            <!-- 2D Rotation Controls -->
            <LinearLayout
                android:id="@+id/rotationControls2D"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/floating_controls_bg"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnRotLeft2D"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="↺"
                    android:textSize="18sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <Button
                    android:id="@+id/btnRotRight2D"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="↻"
                    android:textSize="18sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

            </LinearLayout>

            <!-- Resize Controls (Maximize/Minimize) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:orientation="horizontal">
                
                <ImageButton
                    android:id="@+id/btnMinimizeCanvas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/floating_controls_bg"
                    android:padding="8dp"
                    android:src="@drawable/ic_zoom_out_custom"
                    app:tint="@color/secondary_dark" />

                <ImageButton
                    android:id="@+id/btnMaximizeCanvas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/floating_controls_bg"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_add"
                    app:tint="@color/secondary_dark" />

            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Results Section -->
    <LinearLayout
        android:id="@+id/resultSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/canvasCard"
        app:layout_constraintVertical_weight="0.3">

        <LinearLayout
            android:id="@+id/solutionControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnCopySolution"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/primary" />

            <ImageButton
                android:id="@+id/btnDownloadImage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/secondary" />

            <ImageButton
                android:id="@+id/btnDownloadPdf"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/primary_dark" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/resultScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/stepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:paddingBottom="30dp" />
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
