<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_main">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sketch_tools"
                android:textSize="10sp"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:textColor="@color/text_subtitle"
                android:background="@color/bg_main"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:gravity="bottom">

                    <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="bottom" android:src="@android:drawable/ic_menu_revert" android:background="?attr/selectableItemBackground" app:tint="@color/text_subtitle" android:tooltipText="Back"/>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="bottom" android:background="#DDDDDD" android:layout_marginHorizontal="6dp"/>

                    <!-- VIEW group -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grp_view" android:textSize="9sp" android:textColor="@color/text_subtitle" android:gravity="center" android:letterSpacing="0.06"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <ImageButton android:id="@+id/btnToolMove" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_move" android:background="?attr/selectableItemBackground" app:tint="@color/main_blue" android:tooltipText="Pan"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="bottom" android:background="#DDDDDD" android:layout_marginHorizontal="6dp"/>

                    <!-- DRAW group -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grp_draw" android:textSize="9sp" android:textColor="@color/text_subtitle" android:gravity="center" android:letterSpacing="0.06"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <ImageButton android:id="@+id/btnToolLine" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_line" android:background="?attr/selectableItemBackground" app:tint="@color/main_blue" android:tooltipText="Line"/>
                            <ImageButton android:id="@+id/btnToolPoly" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_edit" android:background="?attr/selectableItemBackground" app:tint="#27AE60" android:tooltipText="Polyline" android:visibility="gone"/>
                            <ImageButton android:id="@+id/btnToolRect" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_rectangle" android:background="?attr/selectableItemBackground" app:tint="@color/main_blue" android:tooltipText="Rectangle"/>
                            <ImageButton android:id="@+id/btnToolCircle" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_circle" android:background="?attr/selectableItemBackground" app:tint="@color/main_blue" android:tooltipText="Circle"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="bottom" android:background="#DDDDDD" android:layout_marginHorizontal="6dp"/>

                    <!-- EDIT group -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grp_edit" android:textSize="9sp" android:textColor="@color/text_subtitle" android:gravity="center" android:letterSpacing="0.06"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <ImageButton android:id="@+id/btnToolSelect" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_selection" android:background="?attr/selectableItemBackground" app:tint="#E67E22" android:tooltipText="Smart Select / Dimension"/>
                            <ImageButton android:id="@+id/btnToolOrtho" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_sort_by_size" android:background="?attr/selectableItemBackground" app:tint="#7F8C8D" android:tooltipText="Toggle Ortho (90°)"/>
                            <ImageButton android:id="@+id/btnUndo" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_undo" android:background="?attr/selectableItemBackground" app:tint="@color/main_blue" android:tooltipText="Undo"/>
                            <ImageButton android:id="@+id/btnRedo" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_redo" android:background="?attr/selectableItemBackground" app:tint="@color/main_blue" android:tooltipText="Redo"/>
                            <ImageButton android:id="@+id/btnToolClear" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_delete" android:background="?attr/selectableItemBackground" app:tint="#C62828" android:tooltipText="Clear Canvas"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:layout_gravity="bottom" android:background="#DDDDDD" android:layout_marginHorizontal="6dp"/>

                    <!-- FILE group -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/grp_file" android:textSize="9sp" android:textColor="@color/text_subtitle" android:gravity="center" android:letterSpacing="0.06"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <Button android:id="@+id/btnOpen3D" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="44dp" android:paddingHorizontal="10dp" android:text="3D" android:textStyle="bold" android:textColor="@color/main_blue" android:tooltipText="Open 3D editor"/>
                            <ImageButton android:id="@+id/btnToolSaveTop" android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_save" android:background="?attr/selectableItemBackground" app:tint="#27AE60" android:tooltipText="Save Drawing"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/canvasCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbarCard"
        app:layout_constraintBottom_toTopOf="@+id/bottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

            <com.example.lemm.CadGeometryCanvas
                android:id="@+id/drawingCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/canvas_bg" />

            <!-- PROPERTIES PANEL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/propertiesPanel"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/surface_white"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Properties"
                        android:textStyle="bold"
                        android:textColor="@color/text_title"
                        android:textSize="12sp"
                        android:paddingBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvShapeInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Area: 0\nLength: 0"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"/>

                    <!-- Action Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnEditProperties"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Dim"
                            android:textSize="10sp"
                            android:textColor="#E67E22"
                            android:padding="0dp"/>

                        <Button
                            android:id="@+id/btnSetAngleAction"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Angle"
                            android:textSize="10sp"
                            android:textColor="@color/main_blue"
                            android:padding="0dp"
                            android:visibility="gone"/>

                        <Button
                            android:id="@+id/btnExtrude3D"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="@string/extrude"
                            android:textSize="10sp"
                            android:textColor="#27AE60"
                            android:padding="0dp"/>

                        <Button
                            android:id="@+id/btnDeleteShape"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Delete"
                            android:textSize="10sp"
                            android:textColor="#C62828"
                            android:padding="0dp"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ZOOM CONTROLS (FIXED) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/floating_controls_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnZoomOut"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="-"
                    android:textColor="@color/main_blue"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvZoomPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="100%"
                    android:textColor="@color/main_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnZoomIn"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="+"
                    android:textColor="@color/main_blue"
                    android:textSize="20sp" />
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:elevation="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDontSave"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dont_save"
            app:strokeColor="#C62828"
            android:textColor="#C62828"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/save_drawing"
            app:backgroundTint="#27AE60" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
