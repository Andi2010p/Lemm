<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appScreenBg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/plans_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/neon_text" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Hero -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plans_hero"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/neon_text"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plans_hero_sub"
                android:textSize="15sp"
                android:textColor="@color/neon_text_dim"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <!-- YOUR PLAN RIGHT NOW -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/appCardFill"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/appCardStroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvCurrentPlan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_free_name"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_cyan" />

                    <!-- The big number: problems left. Not tokens. -->
                    <TextView
                        android:id="@+id/tvProblemsLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_text"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvProblemsLeftLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plans_problems_left"
                        android:textSize="14sp"
                        android:textColor="@color/neon_text_dim" />

                    <ProgressBar
                        android:id="@+id/barCredits"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progress="100" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WHY LEMMA AND NOT A CHATBOT.
                 Deliberately placed BEFORE the prices: the user has to know what they'd be buying
                 that Gemini can't give them for free, or the plan cards are just a lock. -->
            <TextView
                style="@style/SocialSectionLabel"
                android:text="@string/why_title" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/appCardFill"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/appCardStroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/why_headline"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/neon_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/why_sub"
                        android:textSize="13sp"
                        android:textColor="@color/neon_text_dim"
                        android:layout_marginTop="6dp" />

                    <!-- Rows are built in code from the why_both / why_only_lemma arrays. -->
                    <LinearLayout
                        android:id="@+id/whyRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/appCardStroke" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/why_footer"
                        android:textSize="12sp"
                        android:textColor="@color/neon_text_dim" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HOW IT WORKS: money -> credits -> problems -->
            <TextView
                style="@style/SocialSectionLabel"
                android:text="@string/plans_how_it_works" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/appCardFill"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/appCardStroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- The chain, spelled out -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/plans_chain_money"
                            android:textSize="13sp"
                            android:textColor="@color/neon_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="@color/neon_cyan" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/plans_chain_credits"
                            android:textSize="13sp"
                            android:textColor="@color/neon_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="@color/neon_cyan" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/plans_chain_problems"
                            android:textSize="13sp"
                            android:textColor="@color/neon_text" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/appCardStroke" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plans_rate_solve"
                        android:textSize="14sp"
                        android:textColor="@color/neon_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plans_rate_chat"
                        android:textSize="14sp"
                        android:textColor="@color/neon_text"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plans_rate_free_stuff"
                        android:textSize="13sp"
                        android:textColor="@color/neon_text_dim"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly / Annual -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMonthly"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/plans_monthly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnnual"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/plans_annual" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Plan cards get built in code so prices come live from Play -->
            <LinearLayout
                android:id="@+id/plansContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- FAMILY SEATS (only when you own / belong to a collective plan) -->
            <TextView
                android:id="@+id/tvFamilyLabel"
                style="@style/SocialSectionLabel"
                android:text="@string/family_seats_title"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/familyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Need more this month? -->
            <TextView
                style="@style/SocialSectionLabel"
                android:text="@string/plans_topup_title" />

            <LinearLayout
                android:id="@+id/topupContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plans_footer"
                android:textSize="12sp"
                android:textColor="@color/neon_text_dim"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
