<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== App style overlays (Glass vs Basic), chosen in Settings and applied per-activity
         by StyleManager. Each provides the values for the appScreen*/appCard* attributes so every
         themed screen follows the one chosen style. Both are DayNight-safe (the colors they point
         at are themselves light/dark aware). ===== -->
    <style name="ThemeOverlay.Lemm.Glass" parent="">
        <item name="appScreenBg">@drawable/bg_futuristic</item>
        <item name="appCardFill">@color/glass_fill</item>
        <item name="appCardStroke">@color/glass_stroke</item>
        <item name="appCardStrokeWidth">1dp</item>
    </style>

    <style name="ThemeOverlay.Lemm.Basic" parent="">
        <item name="appScreenBg">@drawable/bg_gradient_light</item>
        <item name="appCardFill">@color/surface_white</item>
        <item name="appCardStroke">@color/card_border_basic</item>
        <item name="appCardStrokeWidth">1dp</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.Lemm" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color (Deep Blue) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/surface_white</item>

        <!-- Secondary brand color (Vibrant Cyan) -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/surface_white</item>

        <!-- Backgrounds: a drawable (not a plain color) so the night variant is picked from
             drawable-night/ on the very first frame — color-resource lookup can briefly miss the
             night qualifier when the user has forced Dark while the system is Light, causing a
             white flash before AppCompat applies the override. -->
        <item name="android:windowBackground">@drawable/window_bg</item>

        <!-- GLOBAL MAGIC OVERRIDES (Applies to EVERYTHING) -->
        <item name="materialButtonStyle">@style/ModernButton</item>
        <item name="textInputStyle">@style/ModernTextInputLayout</item>
        <item name="materialAlertDialogTheme">@style/ModernAlertDialog</item>
        <item name="materialCardViewStyle">@style/ModernCardView</item>
    </style>

    <!-- 1. Make ALL Buttons pill-shaped and beautiful -->
    <style name="ModernButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- 2. Make ALL Text Inputs smooth and rounded -->
    <style name="ModernTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/primary_light</item>
        <item name="hintTextColor">@color/primary_light</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
    </style>

    <!-- 3. Make ALL Pop-up Dialogs beautiful and rounded -->
    <style name="ModernAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Background shape of the dialog -->
        <item name="shapeAppearanceOverlay">@style/ModernDialogShape</item>
        <item name="colorSurface">@color/surface_white</item>
        <!-- Color of the Yes/No buttons inside the dialog -->
        <item name="colorPrimary">@color/primary_light</item>
    </style>

    <!-- Defines the rounded corners for the Dialogs -->
    <style name="ModernDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- 4. Give ALL Cards a unified modern look -->
    <style name="ModernCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===== Reusable action buttons: consistent size/shape/icon, dark-mode-safe contrast ===== -->
    <!-- Filled primary. Uses @color/primary (stays a strong blue in dark mode) so white text
         keeps good contrast — main_blue lightens at night and would wash out white text. -->
    <style name="Widget.Lemm.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Secondary / outlined. Text + stroke use main_blue (readable as light blue at night). -->
    <style name="Widget.Lemm.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/main_blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/main_blue</item>
        <item name="iconTint">@color/main_blue</item>
        <item name="rippleColor">@color/icon_bg_blue</item>
    </style>

    <!-- Destructive, prominent (e.g. Log out). -->
    <style name="Widget.Lemm.Button.DangerFilled" parent="Widget.Lemm.Button">
        <item name="backgroundTint">@color/error_red</item>
    </style>

    <!-- Destructive, low-emphasis (e.g. Delete account) — outlined so it isn't tapped by accident. -->
    <style name="Widget.Lemm.Button.DangerOutlined" parent="Widget.Lemm.Button.Outlined">
        <item name="strokeColor">@color/error_red</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="iconTint">@color/error_red</item>
        <item name="rippleColor">@color/error_red</item>
    </style>

    <!-- Tonal (soft filled, no shadow) — modern secondary action. Light-blue fill + blue label;
         both swap to dark-blue fill + light-blue label at night via the color resources. -->
    <style name="Widget.Lemm.Button.Tonal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/icon_bg_blue</item>
        <item name="android:textColor">@color/main_blue</item>
        <item name="iconTint">@color/main_blue</item>
        <item name="rippleColor">@color/main_blue</item>
    </style>

    <!-- Tonal destructive (e.g. Delete account): soft red fill, red label. -->
    <style name="Widget.Lemm.Button.DangerTonal" parent="Widget.Lemm.Button.Tonal">
        <item name="backgroundTint">@color/danger_bg</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="iconTint">@color/error_red</item>
        <item name="rippleColor">@color/error_red</item>
    </style>

    <!-- Section header inside the Friends / chat screens ("Requests", "Your friends"). -->
    <style name="SocialSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/neon_text_dim</item>
    </style>

</resources>