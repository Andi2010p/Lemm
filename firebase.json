{
  "database": {
    "rules": "docs/database.rules.json"
  },
  "storage": {
    "rules": "docs/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local"]
    }
  ],
  "emulators": {
    "database": { "port": 9000, "host": "127.0.0.1" },
    "functions": { "port": 5001, "host": "127.0.0.1" },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
